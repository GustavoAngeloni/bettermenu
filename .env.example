# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (usada nos QR Codes). Em dev pode deixar vazio.
NEXT_PUBLIC_APP_URL=

# Alertas com o celular bloqueado (Web Push). Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://bettermenu.vercel.app

# Importar cardápio por foto (Claude). Sem a chave, só a importação por planilha fica disponível.
ANTHROPIC_API_KEY=

# Opcional: string de conexão do Postgres (Supabase > Project Settings > Database)
# para rodar `npm run db:migrate` em vez de colar o schema no SQL Editor.
SUPABASE_DB_URL=

# Opcional: contato comercial (botão "Fale com a gente" no site) e e-mail da declaração de acessibilidade
NEXT_PUBLIC_CONTACT_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
